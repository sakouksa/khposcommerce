# ==============================================================================
# KHPosCommerce Monorepo Environment Variables
# ==============================================================================

# --- Application ---
APP_NAME=KHPosCommerce
APP_ENV=local
APP_KEY=base64:your_app_key_here
APP_DEBUG=true
APP_URL=http://localhost:8001

# --- Ports Configuration ---
API_PORT=8001
ADMIN_PORT=5174
STOREFRONT_PORT=5173

# --- Database (PostgreSQL 16) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=enterprise_pos
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Redis Cache & Queue ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Frontend Web Clients ---
VITE_API_URL=http://localhost:8001/api/v1
VITE_STORE_API_URL=http://localhost:8001/api/v1/store

# --- National Bank of Cambodia / Bakong KHQR ---
BAKONG_KHQR_MERCHANT_ID=
BAKONG_KHQR_MERCHANT_NAME=
BAKONG_KHQR_MERCHANT_CITY=Phnom Penh
BAKONG_KHQR_ACQUIRING_BANK=Bakong
BAKONG_KHQR_CURRENCY=USD
