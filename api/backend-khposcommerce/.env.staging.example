# ═══════════════════════════════════════════════════════════════════════════════
#  ENTERPRISE POS & E-COMMERCE SYSTEM — STAGING ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

APP_NAME="Enterprise POS [STAGING]"
APP_ENV=staging
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=true
APP_URL=https://api-staging.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=enterprise_pos_staging
DB_USERNAME=postgres_staging
DB_PASSWORD=staging_db_password
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
CACHE_PREFIX=enterprise_pos_staging_cache

QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=staging_redis_password
REDIS_PORT=6379

FILESYSTEM_DISK=local

JWT_SECRET=GENERATE_STAGING_64_CHAR_HEX_KEY
JWT_TTL=86400

CORS_ALLOWED_ORIGINS="https://staging.example.com,https://admin-staging.example.com"

MAIL_MAILER=log
TELESCOPE_ENABLED=true
