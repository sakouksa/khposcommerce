# ═══════════════════════════════════════════════════════════════════════════════
#  ENTERPRISE POS & E-COMMERCE SYSTEM — PRODUCTION ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

APP_NAME="Enterprise POS"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Process concurrency
PHP_CLI_SERVER_WORKERS=8
BCRYPT_ROUNDS=12

# ─── Logging & Telemetry ──────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# ─── PostgreSQL 16 Production Database ────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=enterprise_pos
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_TO_STRONG_PRODUCTION_PASSWORD
DB_SSLMODE=prefer

# ─── Session Management ───────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true

# ─── Cache & Queue (Redis 7) ──────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=enterprise_pos_cache

QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ─── Filesystem & Media Storage ───────────────────────────────────────────────
FILESYSTEM_DISK=local
# For AWS S3 / MinIO Object Storage (Optional):
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=enterprise-pos-media
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── JWT Authentication Secret ────────────────────────────────────────────────
JWT_SECRET=GENERATE_SECURE_64_CHAR_HEX_KEY
JWT_TTL=86400
JWT_REFRESH_TTL=604800

# ─── CORS Allowed Frontend Origins (Comma separated) ──────────────────────────
CORS_ALLOWED_ORIGINS="https://www.example.com,https://example.com,https://admin.example.com"
SANCTUM_STATEFUL_DOMAINS="www.example.com,example.com,admin.example.com"

# ─── Production Email (SMTP) ──────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Telescope (Disabled in Production) ───────────────────────────────────────
TELESCOPE_ENABLED=false
