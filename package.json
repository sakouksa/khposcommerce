{
  "name": "khposcommerce",
  "version": "1.0.0",
  "description": "KHPosCommerce - Unified Omnichannel POS & E-Commerce Ecosystem",
  "private": true,
  "workspaces": [
    "webclient/control-khposcommerce",
    "webclient/merchant-khposcommerce",
    "webclient/storefront-khposcommerce",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx concurrently -n \"API,MERCHANT\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:merchant\"",
    "dev:all": "npx concurrently -n \"API,CONTROL,MERCHANT,STORE\" -c \"blue,yellow,green,magenta\" \"npm run dev:api\" \"npm run dev:control\" \"npm run dev:merchant\" \"npm run dev:storefront\"",
    "dev:api": "cd backend-khposcommerce && php artisan serve --port=8001",
    "dev:control": "cd webclient/control-khposcommerce && npm run dev",
    "dev:merchant": "cd webclient/merchant-khposcommerce && npm run dev",
    "dev:storefront": "cd webclient/storefront-khposcommerce && npm run dev",
    "dev:superadmin": "npm run dev:control",
    "dev:platform": "npm run dev:control",
    "dev:admin": "npm run dev:merchant",
    "dev:mobile": "cd app-khposcommerce && flutter run",
    "api": "npm run dev:api",
    "control": "npm run dev:control",
    "superadmin": "npm run dev:control",
    "platform": "npm run dev:control",
    "merchant": "npm run dev:merchant",
    "admin": "npm run dev:merchant",
    "storefront": "npm run dev:storefront",
    "mobile": "npm run dev:mobile",
    "build": "npm run build:merchant && npm run build:storefront",
    "build:merchant": "cd webclient/merchant-khposcommerce && npm run build",
    "build:control": "cd webclient/control-khposcommerce && npm run build",
    "build:admin": "npm run build:merchant",
    "build:superadmin": "npm run build:control",
    "build:storefront": "cd webclient/storefront-khposcommerce && npm run build",
    "setup": "npm run setup:api && npm run setup:apps",
    "setup:api": "cd backend-khposcommerce && composer install && cp -n .env.example .env && php artisan key:generate",
    "setup:apps": "npm install",
    "db:migrate": "cd backend-khposcommerce && php artisan migrate",
    "db:seed": "cd backend-khposcommerce && php artisan db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
